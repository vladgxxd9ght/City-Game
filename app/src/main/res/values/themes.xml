<resources xmlns:tools="http://schemas.android.com/tools">

    <style name="Base.Theme.CityGame" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">#4F46E5</item>
        <item name="colorOnPrimary">#FFFFFF</item>

        <item name="android:colorBackground">#F8FAFC</item>
        <item name="android:windowBackground">#F8FAFC</item>

        <item name="colorSurface">#FFFFFF</item>
        <item name="colorOnSurface">#0F172A</item>

        <item name="android:fontFamily">sans-serif-medium</item>

        <item name="actionBarPopupTheme">@style/ThemeOverlay.App.LightMenu</item>
    </style>

    <style name="ThemeOverlay.App.LightMenu" parent="ThemeOverlay.AppCompat.Light">
        <item name="android:textColor">#0F172A</item>
        <item name="android:textColorPrimary">#0F172A</item>
    </style>

    <style name="Theme.CityGame" parent="Base.Theme.CityGame" />

    <style name="Theme.CityGame.AppWidgetContainerParent" parent="@android:style/Theme.DeviceDefault">
        <!-- Radius of the outer bound of widgets to make the rounded corners -->
        <item name="appWidgetRadius">16dp</item>
        <!--
        Radius of the inner view's bound of widgets to make the rounded corners.
        It needs to be 8dp or less than the value of appWidgetRadius
        -->
        <item name="appWidgetInnerRadius">8dp</item>
    </style>

    <style name="Theme.CityGame.AppWidgetContainer" parent="Theme.CityGame.AppWidgetContainerParent">
        <!-- Apply padding to avoid the content of the widget colliding with the rounded corners -->
        <item name="appWidgetPadding">16dp</item>
    </style>
</resources>